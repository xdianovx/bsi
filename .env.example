# Копия -> .env (в git не попадает)

# Выключатель интеграции с хабом: 0 — отели только из WordPress (CPT hotel)
BSI_HOTELS_API_ENABLED=1

# BSIHOTELS API — хаб отелей (Go + PostgreSQL). Прод-хаб; локальный — http://localhost:8090
BSI_HOTELS_API_URL=https://api.80.87.197.81.sslip.io
# Таймаут HTTP-запроса к API, секунды. Холодная карточка отеля тянет цены у поставщика
BSI_HOTELS_API_TIMEOUT=2
