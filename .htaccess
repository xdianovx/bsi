# Кеширование статики темы.
#
# Сервер отдаёт CSS, JS и картинки с Cache-Control: max-age=3600 (час),
# а шрифты — вообще без заголовка, из-за чего повторные визиты качают
# всё заново. Файлы темы версионируются параметром ?ver= в enqueue,
# поэтому длинный срок хранения безопасен: после сборки меняется ver и
# браузер берёт новую версию.
#
# Директивы обёрнуты в IfModule: если модуля нет или связка работает
# без Apache, файл просто ничего не делает.

<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"

  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType application/font-woff2  "access plus 1 year"

  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|jpe?g|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Служебный заголовок: по нему видно, что правила применились.
  <FilesMatch "\.woff2$">
    Header set X-BSI-Cache-Rules "theme-htaccess"
  </FilesMatch>
</IfModule>
